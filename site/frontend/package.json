{
  "name": "efhc-frontend",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "npm run typecheck && next build --webpack",
    "start": "next start -p 3000",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "performance-budgets": "node src/reconstruction/pages_ci/budgets.mjs",
    "release-assets:verify": "node src/reconstruction/pages_ci/verify-production-assets.mjs",
    "test:frontend-regression": "node --test tests/parity/contracts.test.mjs tests/regression/current-*.test.mjs",
    "check:frontend-regression": "npm run test:frontend-regression",
    "test:tonconnect-update-acceptance": "node --test tests/regression/current-official-tonconnect-runtime.test.mjs",
    "check:tonconnect-update-acceptance": "npm run test:tonconnect-update-acceptance",
    "music:playlist": "node scripts/generate-background-playlist.mjs",
    "test:html-react-parity": "node --test tests/parity/contracts.test.mjs",
    "prebuild": "npm run release-assets:verify"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@ton/crypto-primitives": "2.1.0",
    "@ton/ton": "16.3.0",
    "@tonconnect/sdk": "5.0.0",
    "@tonconnect/ui-react": "5.0.1",
    "@twa-dev/sdk": "^8.0.2",
    "axios": "1.21.1",
    "buffer": "^6.0.3",
    "dataloader": "^2.0.0",
    "eventsource": "^2.0.2",
    "jssha": "3.3.3",
    "next": "16.4.3",
    "node-fetch": "^3.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@serwist/cli": "9.5.13",
    "@serwist/next": "9.5.13",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^20.14.10",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "postcss": "^8.5.10",
    "serwist": "9.5.13",
    "tailwindcss": "4.3.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "axios": "$axios",
    "follow-redirects": "^1.16.2",
    "postcss": "$postcss",
    "@ton/ton": {
      "zod": "$zod"
    }
  }
}
